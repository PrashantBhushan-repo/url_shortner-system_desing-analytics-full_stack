{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node test/tracePropagation.test.js && node test/metrics.test.js && node test/mcp.test.mjs",
    "test:telemetry": "node test/tracePropagation.test.js",
    "start": "node server.js",
    "dev": "concurrently --kill-others --names backend,worker \"npm:dev:backend\" \"npm:worker:dev\"",
    "dev:backend": "node scripts/dev.mjs backend",
    "worker:dev": "node scripts/dev.mjs worker",
    "dev:setup": "node scripts/dev.mjs setup",
    "dev:check": "node scripts/dev.mjs check",
    "worker": "node worker/index.js",
    "worker:billing": "node worker/billing.js",
    "billing:test-local": "node scripts/billing-test-local.mjs",
    "billing:verify-test": "node scripts/billing-test-verify.mjs",
    "db:init": "node scripts/env.mjs -- node_modules/prisma/build/index.js migrate deploy",
    "db:migrate": "node scripts/env.mjs -- node_modules/prisma/build/index.js migrate deploy",
    "seed:admin": "node prisma/seedAdmin.js",
    "mcp": "node bin/pburls-mcp.js",
    "test:demo": "node --test test/demoAccess.test.mjs",
    "test:workspace": "node --experimental-test-module-mocks --test test/linkSafety.test.mjs test/urlService.test.mjs test/workspacePostgres.test.mjs test/location.test.mjs",
    "test:auth": "node --experimental-test-module-mocks --test test/authFlows.test.mjs",
    "test:billing": "node --experimental-test-module-mocks --test test/billing.test.mjs test/billingGateway.test.mjs test/billingPostgres.test.mjs test/billingRecovery.test.mjs",
    "start:prod": "node scripts/env.mjs production -- server.js",
    "worker:prod": "node scripts/env.mjs production -- worker/index.js",
    "env:check": "node scripts/env.mjs",
    "test:env": "node --test test/environment.test.mjs",
    "db:generate": "node scripts/env.mjs -- node_modules/prisma/build/index.js generate",
    "db:migrate:prod": "node scripts/env.mjs production -- node_modules/prisma/build/index.js migrate deploy",
    "test:observability": "node --test test/observability.test.mjs"
  },
  "bin": {
    "pburls-mcp": "./bin/pburls-mcp.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "^7.10.1",
    "@prisma/instrumentation": "7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "10.2.1",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3",
    "ua-parser-js": "^2.0.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
