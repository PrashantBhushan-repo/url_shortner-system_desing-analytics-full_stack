generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model Url {
  id           BigInt    @id @default(autoincrement())
  short_code   String    @unique @db.VarChar(10)
  long_url     String
  user_id      BigInt?
  custom_alias Boolean?  @default(false)
  is_active    Boolean?  @default(true)
  expires_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  clicks       Click[]

  @@index([short_code], map: "idx_urls_short_code")
}

model Click {
  id                BigInt   @id @default(autoincrement())
  url_id            BigInt
  visitor_id        String
  ip_address        String?
  clicked_at        DateTime @default(now())
  browser           String?
  browser_version   String?
  operating_system  String?
  os_version        String?
  device_type       String?
  device_name       String?
  platform          String?
  user_agent        String?
  country           String?
  state             String?
  city              String?
  latitude          Float?
  longitude         Float?
  timezone          String?
  referrer          String?
  referer_host      String?
  utm_source        String?
  utm_medium        String?
  utm_campaign      String?
  is_qr_scan        Boolean  @default(false)
  is_unique         Boolean  @default(true)
  session_id        String?
  language          String?
  screen_resolution String?
  network_type      String?
  url               Url      @relation(fields: [url_id], references: [id], onDelete: Cascade)

  @@index([url_id])
}
