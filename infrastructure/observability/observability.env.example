# Production: save as /etc/pburls/observability.env (root-owned, chmod 600).
# Grafana Cloud -> Connections -> OpenTelemetry -> configure an OTLP connection.
# Endpoint includes /otlp when shown by Grafana; do not append /v1/traces.
OTLP_ENDPOINT=https://otlp-gateway-REGION.grafana.net/otlp
OTLP_USERNAME=YOUR_STACK_INSTANCE_ID
# Access policy token with metrics:write, logs:write, traces:write for this stack.
OTLP_PASSWORD=REPLACE_WITH_GRAFANA_CLOUD_TOKEN
# Exactly 64 hexadecimal characters; generate with: openssl rand -hex 32
OBS_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
