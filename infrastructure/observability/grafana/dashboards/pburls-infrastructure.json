{
  "uid": "pburls-infrastructure",
  "title": "PBUrls · Database, Redis and Host",
  "description": "Host panels are intentionally empty locally on Docker Desktop. Blocked Redis clients can include healthy BullMQ blocking consumers. Disk block reads do not include OS page-cache hits. Missing data is not zero.",
  "tags": [
    "pburls"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "logs",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "environment",
        "type": "custom",
        "query": "development,production,test",
        "current": {
          "text": "development",
          "value": "development"
        }
      },
      {
        "name": "service",
        "type": "custom",
        "query": "pburls-backend,pburls-worker",
        "multi": true,
        "includeAll": true,
        "allValue": "pburls-.*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Public HTTPS probe success (production)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{environment=\"$environment\"}",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Public HTTPS round trip (production)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
