      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(pburls_redis_cache_hits_total{environment=\"$environment\",service=~\"$service\"}[$__rate_interval])) or vector(0)) / ((sum(rate(pburls_redis_cache_hits_total{environment=\"$environment\",service=~\"$service\"}[$__rate_interval])) or vector(0)) + (sum(rate(pburls_redis_cache_misses_total{environment=\"$environment\",service=~\"$service\"}[$__rate_interval])) or vector(0)))",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
