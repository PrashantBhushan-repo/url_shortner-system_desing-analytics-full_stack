{
  "uid": "pburls-workers",
  "title": "PBUrls · Workers",
  "description": "Jobs count processing attempts, not unique business events. Failed/completed gauges include retained history. Scheduled and retried jobs include their delays; use click-queue for ingestion latency.",
  "tags": [
    "pburls"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "logs",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "environment",
        "type": "custom",
        "query": "development,production,test",
        "current": {
          "text": "development",
          "value": "development"
        }
      },
      {
        "name": "service",
        "type": "custom",
        "query": "pburls-backend,pburls-worker",
        "multi": true,
        "includeAll": true,
        "allValue": "pburls-.*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Queue jobs by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pburls_queue_jobs{environment=\"$environment\"}",
          "legendFormat": "{{queue}} · {{state}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Queue collection success",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pburls_queue_poll_success{environment=\"$environment\"}",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Job attempts / second by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(queue,outcome)(rate(pburls_queue_jobs_total{environment=\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{queue}} · {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Processing p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(pburls_queue_job_duration_seconds_bucket{environment=\"$environment\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Click queue wait p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(pburls_queue_wait_seconds_bucket{environment=\"$environment\",queue=\"click-queue\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Click queue creation-to-success p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(pburls_queue_end_to_end_seconds_bucket{environment=\"$environment\",queue=\"click-queue\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
