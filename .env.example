# Docker infrastructure and optional full container stack. Copy to .env.
# Default: node infrastructure/scripts/local.mjs up (only 4 infrastructure containers).
# Integration: node infrastructure/scripts/local.mjs --full-stack up (all 7).
# Compose uses this same file for interpolation AND container injection.
BACKEND_ENV_FILE=./.env
NODE_ENV=development
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Only use a trusted Docker subnet when backend is reachable exclusively via Nginx.
TRUST_PROXY=uniquelocal
# Keep DB_* and DATABASE_URL consistent; existing database passwords don't change
# when env files change. Use existing credentials for an already initialized volume.
DB_NAME=url_shortener
DB_USER=postgres
DB_PASSWORD=local_dev_only
DB_HOST_PORT=5435
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=3000
# Native metrics ports: shared by the native npm launchers and Alloy's host targets.
BACKEND_METRICS_PORT=9464
WORKER_METRICS_PORT=9465
DATABASE_URL=postgresql://postgres:local_dev_only@db:5432/url_shortener
REDIS_URL=redis://redis:6379
JWT_SECRET=development-only-replace-with-a-random-secret
# Secrets: keep real values only in untracked files / runtime environment.
# No variable expansion here: write complete URLs and URL-encode URL passwords.
# Runtime/shell variables take priority over file values.
PORT=5000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
CACHE_TTL_SECONDS=21600
CREATE_URL_RATE_LIMIT_WINDOW_MS=86400000
CREATE_URL_RATE_LIMIT_MAX=100
REDIRECT_RATE_LIMIT_WINDOW_MS=60000
REDIRECT_RATE_LIMIT_MAX=100

# Optional email. Supply valid credentials to deliver verification/reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
BYPASS_EMAIL_ERROR=false

# Optional payment provider: sandbox keys in development, live keys in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=

# Optional OAuth. Callback URLs must exactly match provider registrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REDIRECT_URI=

# Optional one-time admin bootstrap. Do not run seeds on every production restart.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
ADMIN_IP_ALLOWLIST=

# The optional local observability Compose overlay enables export automatically.
# See infrastructure/observability/README.md. Metric ports stay internal to Docker.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME is normally assigned by backend/worker service automatically.
# Optional overrides: METRICS_PORT, OTEL_EXPORTER_OTLP_TRACES_ENDPOINT,
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT, OTEL_COLLECTOR_HOST, OTEL_COLLECTOR_PORT.
# PBURLS_API_KEY is only needed when using the MCP CLI.
